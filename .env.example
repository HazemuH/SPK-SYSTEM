# Copy to `.env` for `docker compose up`. Override all of these in production.
DB_PASSWORD=spk_mainan
JWT_SECRET=change-me-to-a-long-random-256-bit-secret
CORS_ALLOWED_ORIGINS=*

# Public domain for HTTPS (only needed with docker-compose.https.yml / Caddy).
# Point this domain's A record at the VM's external IP, e.g. DOMAIN=kidora.duckdns.org
DOMAIN=
