<?xml version="1.0" encoding="utf-8"?>
<!--
  Allow cleartext (HTTP) traffic ONLY to the deployed backend IP. Android blocks
  cleartext by default; this scopes the exception to just our server so the rest of
  the app stays HTTPS-only. Remove this file once the backend is served over HTTPS
  (e.g. via a domain + Caddy) and point ApiConfig.baseUrl at https://.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">8.229.130.9</domain>
    </domain-config>
</network-security-config>
